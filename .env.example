# Base de datos Neon PostgreSQL
# Para obtener estas credenciales:
# 1. Crea una cuenta en https://neon.tech
# 2. Crea un nuevo proyecto
# 3. Copia el Connection String desde el dashboard
# 4. Copia por separado la URL con pooling y la URL directa. Ambas conservan TLS.

# Connection pooling URL (para Prisma)
DATABASE_URL="postgresql://username:password@ep-xxx-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct URL (para migraciones)
DIRECT_URL="postgresql://username:password@ep-xxx-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Sesiones: generar un secreto propio.
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Guardas del build de Vercel (scripts/vercel-migrate.mjs). Solo hosts, sin credenciales.
# PRODUCTION_DATABASE_HOST: host de la rama `main` de Neon; si un ambiente que no es
#   Production apunta ahí, el build se detiene sin migrar. Configurar en todos los ambientes.
# PREVIEW_DATABASE_HOST: host de la rama de preview (no usar con "una rama Neon por deploy").
# SKIP_DB_MIGRATE=1: compilar sin aplicar migraciones.
# Vercel informa VERCEL_ENV automáticamente; APP_ENV sirve fuera de Vercel.
# PRODUCTION_DATABASE_HOST="ep-produccion.region.aws.neon.tech"
# APP_ENV="preview"
# PREVIEW_DATABASE_HOST="ep-rama-pruebas.region.aws.neon.tech"

# Otras variables de entorno (agregar según necesidad)
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Opcional: envío de invitaciones por correo (Resend). Sin estas variables,
# la pantalla de Equipo ofrece copiar el enlace o compartirlo por WhatsApp.
# RESEND_API_KEY=
# EMAIL_FROM="AgroMonitor <no-responder@tu-dominio.com>"

# Opcional: asistente de WhatsApp (WhatsApp Cloud API de Meta + Claude).
# Sin estas variables el webhook responde 503 y «Mi cuenta» avisa que no está habilitado.
# WHATSAPP_TOKEN=               # token permanente de un usuario del sistema de Meta Business
# WHATSAPP_PHONE_NUMBER_ID=     # id del número en la app de Meta (no es el número)
# WHATSAPP_APP_SECRET=          # App Secret: valida la firma de cada aviso del webhook
# WHATSAPP_VERIFY_TOKEN=        # texto libre que se repite en el panel de Meta al configurar el webhook
# WHATSAPP_NUMERO=              # número del bot con código de país, para el enlace wa.me (ej. 5492966123456)
# ANTHROPIC_API_KEY=            # clave de la API de Claude
# WHATSAPP_MODELO=claude-opus-5-5   # opcional: modelo del asistente
# Gasto real en «Configuración → Asistente de WhatsApp» (opcional; sin esto se muestra el estimado):
# ANTHROPIC_ADMIN_KEY=          # clave de ADMINISTRADOR de Anthropic (sk-ant-admin…), solo lee el informe de costos
# ANTHROPIC_WORKSPACE_ID=       # opcional: limita el informe de Anthropic a ese espacio de trabajo
# WHATSAPP_WABA_ID=             # id de la cuenta de WhatsApp Business (pricing_analytics de Meta)
